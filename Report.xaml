<Window x:Class="WeldingManagerApp.Report"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeldingManagerApp"
        mc:Ignorable="d"
        Title="Report" Height="450" Width="800">
    <Grid>
        <Label Content="Customer Id" HorizontalAlignment="Left" Margin="142,74,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="CustomerIdBox" HorizontalAlignment="Left" Height="26" Margin="265,74,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="108"/>

        <DatePicker x:Name="StartDateDatePicker" HorizontalAlignment="Left" Margin="268,125,0,0" VerticalAlignment="Top"/>
        <Label Content="from" HorizontalAlignment="Left" Margin="142,124,0,0" VerticalAlignment="Top" Width="75"/>

        <Label Content="to" HorizontalAlignment="Left" Margin="424,125,0,0" VerticalAlignment="Top" Width="69"/>
        <DatePicker x:Name="EndDateDatePicker" HorizontalAlignment="Left" Margin="516,127,0,0" VerticalAlignment="Top"/>
        <Label Content="price from" HorizontalAlignment="Left" Margin="142,191,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="StartPriceBox" HorizontalAlignment="Left" Margin="259,195,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="to&#xD;&#xA;" HorizontalAlignment="Left" Margin="421,187,0,0" VerticalAlignment="Top" Height="30" Width="72"/>
        <TextBox x:Name="EndPriceBox" HorizontalAlignment="Left" Margin="516,195,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Order Id" HorizontalAlignment="Left" Margin="142,247,0,0" VerticalAlignment="Top" Width="65"/>
        <TextBox x:Name="OrderIdBox" HorizontalAlignment="Left" Margin="259,247,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="FilterBtn" Content="Filter" HorizontalAlignment="Left" Height="25" Margin="377,344,0,0" VerticalAlignment="Top" Width="116" Click="FilterBtn_Click"/>



    </Grid>
</Window>
