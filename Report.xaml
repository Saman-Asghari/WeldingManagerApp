<Window x:Class="WeldingManagerApp.Report"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeldingManagerApp"
        mc:Ignorable="d"
        Title="Report" Height="450" Width="800">
    <Grid Margin="0,0,0,-6">
        <!-- Define two rows: Top (Auto) and Bottom (*) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="130"/>
            <!-- Top part, currently empty -->
            <RowDefinition/>
            <!-- Bottom part, where your elements will go -->
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="10,10,10,10">
            <Label Content="Filtered Orders" FontSize="16" FontWeight="Bold" Margin="10"/>
            <ListBox x:Name="OrderListBox" HorizontalAlignment="Left" Height="200" Width="780">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Order ID: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding OrderId}" Margin="5,0"/>

                            <TextBlock Text="Customer ID: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding CustomerId}" Margin="5,0"/>

                            <TextBlock Text="Finished Price: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding lastPrice}" Margin="5,0"/>

                            <TextBlock Text="Order Date: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding EstimatedTime, StringFormat={}{0:yyyy-MM-dd}}" Margin="5,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>



        <!-- Bottom Part (StackPanel to organize your elements vertically) -->
        <StackPanel Grid.Row="1" Margin="20,20,20,20">

            <!-- Customer Id -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Customer Id" VerticalAlignment="Center" Width="120"/>
                <TextBox x:Name="CustomerIdBox" Width="120" Height="26"/>
            </StackPanel>

            <!-- Start Date -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="from" VerticalAlignment="Center" Width="120"/>
                <DatePicker x:Name="StartDateDatePicker" Width="150"/>
            </StackPanel>

            <!-- End Date -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="to" VerticalAlignment="Center" Width="120"/>
                <DatePicker x:Name="EndDateDatePicker" Width="150"/>
            </StackPanel>

            <!-- Price Range (Start) -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="price from" VerticalAlignment="Center" Width="120"/>
                <TextBox x:Name="StartPriceBox" Width="120"/>
            </StackPanel>

            <!-- Price Range (End) -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="to" VerticalAlignment="Center" Width="120"/>
                <TextBox x:Name="EndPriceBox" Width="120"/>
            </StackPanel>

            <!-- Order Id -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Order Id" VerticalAlignment="Center" Width="120"/>
                <TextBox x:Name="OrderIdBox" Width="120"/>
            </StackPanel>

            <!-- Filter Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Button x:Name="FilterBtn" Content="Filter" Width="120" Margin="10,0,0,0" Click="FilterBtn_Click"/>
                <Button x:Name="CreateImageBtn" Content="Clear" Width="120" Margin="10,0,0,0" Click="ClearBtn_Click"/>
                <Button x:Name="ExportBtn" Content="Export" Width="120" Margin="10,0,0,0" Click="ExportBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</Window>
