<Window x:Class="WeldingManagerApp.AddUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeldingManagerApp"
        mc:Ignorable="d"
        Title="AddUser" Height="450" Width="800">
    <Grid>
        <Label Content="Name:" HorizontalAlignment="Left" Margin="198,97,0,0" VerticalAlignment="Top" Width="76"/>
        <TextBox x:Name="NameBox" HorizontalAlignment="Left" Height="26" Margin="328,97,0,0" TextWrapping="Wrap" Text="Enter name" VerticalAlignment="Top" Width="108"/>
        <Label Content="email" HorizontalAlignment="Left" Margin="198,145,0,0" VerticalAlignment="Top" Width="62"/>
        <Label Content="Budget" HorizontalAlignment="Left" Margin="198,191,0,0" VerticalAlignment="Top" Width="62"/>
        <TextBox x:Name="EmailBox" HorizontalAlignment="Left" Height="26" Margin="328,145,0,0" TextWrapping="Wrap" Text="Enter email" VerticalAlignment="Top" Width="108" TextChanged="EmailBox_TextChanged"/>
        <TextBox x:Name="BudgetBox" HorizontalAlignment="Left" Height="26" Margin="328,191,0,0" TextWrapping="Wrap" Text="Enter budget" VerticalAlignment="Top" Width="108"/>
        <Button x:Name="SubmitBtn" Content="Accept" HorizontalAlignment="Left" Margin="295,254,0,0" VerticalAlignment="Top" Width="105" Click="SubmitBtn_Click"/>

    </Grid>
</Window>
