<Window x:Class="WeldingManagerApp.AddOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeldingManagerApp"
        mc:Ignorable="d"
        Title="AddOrder" Height="450" Width="800">
    <Grid>
        <Label Content="Description" HorizontalAlignment="Left" Margin="69,35,0,0" VerticalAlignment="Top" Width="85"/>
        <TextBox x:Name="DescriptionBox" HorizontalAlignment="Left" Height="26" Margin="223,35,0,0" TextWrapping="Wrap" Text="Enter Description" VerticalAlignment="Top" Width="188"/>
        <Label Content="Piece Name" HorizontalAlignment="Left" Height="24" Margin="69,85,0,0" VerticalAlignment="Top" Width="85"/>
        <TextBox x:Name="PieceBox" HorizontalAlignment="Left" Height="27" Margin="223,85,0,0" TextWrapping="Wrap" Text="Enter the piece name" VerticalAlignment="Top" Width="188"/>
        <Label Content="Difficulty" HorizontalAlignment="Left" Height="30" Margin="69,133,0,0" VerticalAlignment="Top" Width="85"/>
        <ComboBox x:Name="DifficultyChoice" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="223,133,0,0">
            <ComboBoxItem Content="Hard" />
            <ComboBoxItem Content="Meduim" />
            <ComboBoxItem Content="Easy" />
        </ComboBox>
        <Label Content="Base Price" HorizontalAlignment="Left" Height="28" Margin="69,189,0,0" VerticalAlignment="Top" Width="93"/>
        <TextBox x:Name="BasePriceBox" HorizontalAlignment="Left" Height="28" Margin="222,189,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="190"/>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="242,240,0,0">
            <!-- DatePicker for Date selection -->
            <DatePicker x:Name="DeliverTime" />

            <!-- TextBox for Time input -->
            <!-- Button to get DateTime -->
        </StackPanel>
        <Label Content="Deliver time" HorizontalAlignment="Left" Height="35" Margin="79,240,0,0" VerticalAlignment="Top" Width="95"/>
        <Label Content="Customer id" HorizontalAlignment="Left" Height="27" Margin="68,296,0,0" VerticalAlignment="Top" Width="95"/>
        <TextBox x:Name="CustomerIdBox" HorizontalAlignment="Left" Height="28" Margin="222,296,0,0" TextWrapping="Wrap" Text="Enter" VerticalAlignment="Top" Width="158"/>
        <Button x:Name="SubmitOrderBtn" Content="Accept" HorizontalAlignment="Left" Margin="242,368,0,0" VerticalAlignment="Top" Width="96" Click="SubmitOrderBtn_Click"/>
    </Grid>
</Window>
