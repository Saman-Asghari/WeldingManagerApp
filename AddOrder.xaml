<Window x:Class="WeldingManagerApp.AddOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Add Order" Height="450" Width="800"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Add New Order" 
                   FontSize="30" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource PrimaryHueDarkBrush}" 
                   HorizontalAlignment="Center" Height="60" VerticalAlignment="Top"/>

        <!-- Form Section -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="400" Margin="0,0,0,6">

            <!-- Description -->
            <TextBox x:Name="DescriptionBox" 
                     materialDesign:HintAssist.Hint="Description" 
                     Width="300" 
                     Height="40" 
                     Margin="0,0,0,10"
                     Text=""/>

            <!-- Piece Name -->
            <TextBox x:Name="PieceBox" 
                     materialDesign:HintAssist.Hint="Piece Name" 
                     Width="300" 
                     Height="40"
                     Margin="0,0,0,10"
                     Text=""/>
            <ComboBox x:Name="DifficultyChoice" 
                      materialDesign:HintAssist.Hint="Difficulty" 
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                      Width="300" 
                      Margin="0,0,0,10"
                      Height="40">
                <ComboBoxItem Content="Hard"/>
                <ComboBoxItem Content="Medium"/>
                <ComboBoxItem Content="Easy"/>
            </ComboBox>

            <!-- Difficulty -->

            <!-- Base Price -->
            <TextBox x:Name="BasePriceBox" 
                     materialDesign:HintAssist.Hint="Base Price" 
                     Width="300" 
                     Height="40" 
                     Margin="0,0,0,10"
                     Text=""/>

            <!-- Deliver Time -->
            <DatePicker x:Name="DeliverTime" 
                        materialDesign:HintAssist.Hint="Deliver Time" 
                        Style="{StaticResource MaterialDesignDatePicker}" 
                        Width="300" 
                        Margin="0,0,0,10"
                        Height="40"/>

            <!-- Customer ID -->
            <TextBox x:Name="CustomerIdBox" 
                     materialDesign:HintAssist.Hint="Customer ID" 
                     Width="300" 
                     Height="45" 
                     Margin="0,0,0,10"
                     Text=""/>
            <Button x:Name="SubmitOrderBtn" 
                    Content="Submit Order" 
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Background="Purple"
                    Foreground="White" 
                    Width="200" 
                    Height="50" 
                    Click="SubmitOrderBtn_Click"/>

            <!-- Submit Button -->
        </StackPanel>
    </Grid>
</Window>
