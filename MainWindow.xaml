<Window x:Class="WeldingManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeldingManagerApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <!-- Left part -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="LightGray">
            <TextBlock Text="Left Part" FontSize="24" Margin="10"/>
            <!-- Add other UI elements here -->
            <Button Content="Button 1" Margin="10"/>
            <Button Content="Button 2" Margin="10"/>
        </StackPanel>


        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Buttons in Right Part -->
            <Button x:Name="SubmitCustomerBtn" Content="Submit a Customer" Grid.Row="0" Margin="10" Click="SubmitCustomerBtn_Click" />
            <Button x:Name="SubmitOrderBtn" Content="Submit an Order" Grid.Row="1" Margin="10" />
            <Button x:Name="ReportBtn" Content="Report" Grid.Row="2" Margin="10" />
        </Grid>
    </Grid>
</Window>
