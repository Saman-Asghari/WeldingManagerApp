<Window x:Class="WeldingManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WeldingManagerApp"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="LightGray">
            <TextBlock Text="Order List" FontSize="24" Margin="10"/>
            <ListBox x:Name="orderListBox" Margin="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Description}" 
                                      Tag="{Binding}" 
                                      Checked="CheckBox_Checked" 
                                      Margin="5"/>
                            <TextBlock Text="{Binding OrderId}" Margin="5"/>
                            <TextBlock Text="{Binding LastPrice, StringFormat=C}" Margin="5"/>
                            <TextBlock Text="{Binding CustomerId}" Margin="5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button x:Name="SubmitCustomerBtn" Content="Submit a Customer" 
                    Grid.Row="0" Margin="10" 
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button x:Name="SubmitOrderBtn" Content="Submit an Order" 
                    Grid.Row="1" Margin="10" 
                    Style="{StaticResource MaterialDesignFlatButton}" />
            <Button x:Name="FinishingOrderBtn" Content="Finishing an Order" 
                    Grid.Row="2" Margin="10" 
                    Style="{StaticResource MaterialDesignFlatButton}" />
            <Button x:Name="ReportBtn" Content="Report" 
                    Grid.Row="3" Margin="10" 
                    Style="{StaticResource MaterialDesignFlatButton}" />
        </Grid>
    </Grid>
</Window>
